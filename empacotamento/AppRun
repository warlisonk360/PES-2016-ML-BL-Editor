#!/bin/bash
# Ponto de entrada da AppImage: roda o editor com o Python portátil embutido.
# Qualquer argumento é repassado (permite abrir um save direto:
#   ./PES2016-MLBL-Editor-PC-x86_64.AppImage BL00000000)
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
APP="$HERE/usr/share/pes2016mlbl"
export PYTHONPATH="$APP${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONDONTWRITEBYTECODE=1
exec "$HERE/usr/python/bin/python3" "$APP/main.py" "$@"
